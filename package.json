{
  "name": "jarvis-ops-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Approval-gated personal operations agent powered by TrueForge.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n ui,api,mcp -c cyan,magenta,yellow \"npm:dev -w @jarvis/control-center\" \"npm:dev -w @jarvis/orchestrator\" \"npm:dev -w @jarvis/google-workspace-mcp\"",
    "dev:ui": "npm run dev -w @jarvis/control-center",
    "dev:api": "npm run dev -w @jarvis/orchestrator",
    "dev:mcp": "npm run dev -w @jarvis/google-workspace-mcp",
    "build": "node scripts/run-existing-workspaces.mjs build",
    "check": "npm run typecheck:scripts && node scripts/run-existing-workspaces.mjs typecheck && node scripts/run-existing-workspaces.mjs test",
    "test": "node scripts/run-existing-workspaces.mjs test",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --pretty false",
    "setup:trueforge": "tsx scripts/setup-trueforge.ts",
    "trueforge": "npx @truefoundry/trueforge@latest"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
