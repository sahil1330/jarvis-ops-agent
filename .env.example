# TrueForge
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=openai/gpt-5.2
TRUEFORGE_TOKEN=
JARVIS_AGENT_NAME=jarvis-personal-ops
JARVIS_MCP_SERVER_NAME=jarvis-google-workspace
JARVIS_MCP_URL=http://localhost:8788/mcp

# App ports
ORCHESTRATOR_PORT=8787
MCP_HOST=127.0.0.1
MCP_PORT=8788
CONTROL_CENTER_ORIGIN=http://localhost:5173

# Generate with: openssl rand -hex 32
JARVIS_MCP_BEARER_TOKEN=

# Google OAuth (never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER_EMAIL=me

# Optional: set true only for UI development. Hackathon demos must use live mode.
JARVIS_DEMO_MODE=false
