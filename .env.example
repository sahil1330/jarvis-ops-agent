# TrueForge
TRUEFORGE_BASE_URL=http://localhost:8790
# Required: use the exact model FQN already configured in your TrueForge instance.
TRUEFORGE_MODEL=
TRUEFORGE_TOKEN=
JARVIS_AGENT_NAME=jarvis-personal-ops
JARVIS_MCP_SERVER_NAME=jarvis-google-workspace
JARVIS_MCP_URL=http://localhost:8788/mcp
JARVIS_GITHUB_MCP_SERVER_NAME=jarvis-github-ops
JARVIS_GITHUB_MCP_URL=http://localhost:8789/mcp

# Voice
# Realtime WebRTC is the preferred human-like output path. Neural MP3 and browser speech remain fallbacks.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_REALTIME_VOICE=marin
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar

# Local app endpoints. Keep the orchestrator and MCP services on loopback.
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8787
MCP_HOST=127.0.0.1
MCP_PORT=8788
GITHUB_MCP_HOST=127.0.0.1
GITHUB_MCP_PORT=8789
CONTROL_CENTER_ORIGIN=http://localhost:5173

# Generate independently with: openssl rand -hex 32
JARVIS_MCP_BEARER_TOKEN=
JARVIS_GITHUB_MCP_BEARER_TOKEN=

# Persistent local memory. Relative paths resolve from the repository root.
JARVIS_MEMORY_PATH=.jarvis/memory.json

# Google OAuth (never commit real values). Gmail always uses the mailbox authenticated by this token via users/me.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# GitHub demo connector. Use a fine-grained token scoped only to the allowlisted repository.
JARVIS_GITHUB_TOKEN=
JARVIS_GITHUB_REPOSITORY=sahil1330/jarvis-ops-agent
JARVIS_GITHUB_BASE_BRANCH=demo-product-main

# Optional: set true only for UI development and deterministic local mission rehearsal.
# The judged recording should use authorized real integrations where required by the submission rules.
JARVIS_DEMO_MODE=false
