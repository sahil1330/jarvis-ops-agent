# TrueForge
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=openai/gpt-5.2
TRUEFORGE_TOKEN=
JARVIS_AGENT_NAME=jarvis-personal-ops
JARVIS_MCP_SERVER_NAME=jarvis-google-workspace
JARVIS_MCP_URL=http://localhost:8788/mcp

# Neural voice (STT + TTS)
# Uses the OpenAI Audio API from the orchestrator. Browser speech remains a fallback.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar

# App ports
ORCHESTRATOR_PORT=8787
MCP_HOST=127.0.0.1
MCP_PORT=8788
CONTROL_CENTER_ORIGIN=http://localhost:5173

# Generate with: openssl rand -hex 32
JARVIS_MCP_BEARER_TOKEN=

# Persistent local memory. Workspace scripts run from apps/google-workspace-mcp.
JARVIS_MEMORY_PATH=../../.jarvis/memory.json

# Google OAuth (never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER_EMAIL=me

# Optional: set true only for UI development. Hackathon demos must use live mode.
JARVIS_DEMO_MODE=false
